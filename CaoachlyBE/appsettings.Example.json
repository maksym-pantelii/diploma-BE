{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=CoachlyAppDb;Username=<db-user>;Password=<db-password>",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "SecretKey": "<random-string-at-least-32-characters>",
    "Issuer": "CoachlyBE",
    "Audience": "CoachlyFE",
    "AccessTokenExpiryMinutes": 15
  },
  "Stripe": {
    "SecretKey": "sk_test_<your-key>",
    "WebhookSecret": "whsec_<your-webhook-secret>",
    "SuccessUrl": "http://localhost:5175/booking/success?session={CHECKOUT_SESSION_ID}",
    "CancelUrl": "http://localhost:5175/booking/cancel"
  },
  "AzureBlob": {
    "ConnectionString": "UseDevelopmentStorage=true"
  },
  "Email": {
    "SenderName": "Coachly",
    "SenderEmail": "<sender@example.com>",
    "AppPassword": "<smtp-app-password>",
    "BusinessName": "Coachly",
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "FrontendBaseUrl": "http://localhost:5175"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5175" ]
  },
  "Booking": {
    "ReservationWindowMinutes": 15,
    "LateFeePercent": 20
  },
  "Cache": {
    "TagsTtlSeconds": 3600
  }
}
